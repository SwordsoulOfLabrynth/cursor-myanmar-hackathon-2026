# Any ONE provider below enables server-side grounded LLM explanations.
# Never expose provider secrets through a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Netlify AI Gateway / any OpenAI-compatible gateway (full chat-completions URL):
# NETLIFY_AI_GATEWAY_URL=
# NETLIFY_AI_GATEWAY_TOKEN=
# AI_MODEL=

# Anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional override for another compatible server-side recommendation endpoint.
# VITE_AI_ENDPOINT=/.netlify/functions/recommend
# Frontend: leave unset to use mock API (same contract as Convex)
VITE_API_MODE=mock

# After `npx convex dev`:
# VITE_CONVEX_URL=
